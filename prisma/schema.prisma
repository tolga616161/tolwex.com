generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Site-wide Meta app configuration (secrets encrypted at rest)
model MetaConfig {
  id                   String   @id @default(cuid())
  appId                String   @default("")
  /// AES-GCM encrypted app secret — never expose to frontend
  encryptedAppSecret   String   @default("")
  redirectUri          String   @default("")
  domain               String   @default("")
  apiVersion           String   @default("v21.0")
  webhookVerifyToken   String   @default("")
  /// Optional — entered by admin when available from Meta panel
  igBusinessAccountId  String   @default("")
  facebookPageId       String   @default("")
  configured           Boolean  @default(false)
  lastTestAt           DateTime?
  lastTestOk           Boolean?
  lastTestMessage      String?
  lastApiRequestAt     DateTime?
  lastApiError         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Anonymous visitor session linked to OAuth connections
model VisitorSession {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  connection InstagramConnection?
  checklist  SecurityChecklist?
}

/// Instagram account connection via official Meta OAuth
model InstagramConnection {
  id                 String         @id @default(cuid())
  visitorSessionId   String         @unique
  visitorSession     VisitorSession @relation(fields: [visitorSessionId], references: [id], onDelete: Cascade)

  /// Meta user id (from Graph API /me)
  metaUserId         String?
  /// Instagram username when provided by API
  igUsername         String?
  /// Instagram business/creator account id when available
  igUserId           String?
  accountType        String?

  /// AES-GCM encrypted long-lived access token — never log or send to client
  encryptedAccessToken String?
  tokenExpiresAt       DateTime?
  grantedScopes        String   @default("[]")
  tokenStatus          String   @default("none") // none | active | expired | revoked | error

  connected            Boolean  @default(false)
  lastCheckedAt        DateTime?
  lastApiError         String?
  lastApiErrorCode     String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  disconnectedAt       DateTime?

  @@index([metaUserId])
}

/// User self-declared security checklist (NOT from Meta API)
model SecurityChecklist {
  id               String         @id @default(cuid())
  visitorSessionId String         @unique
  visitorSession   VisitorSession @relation(fields: [visitorSessionId], references: [id], onDelete: Cascade)

  twoFactorEnabled     Boolean?
  emailSecure          Boolean?
  phoneUpToDate        Boolean?
  unknownDevices       Boolean?
  suspiciousApps       Boolean?
  strongPassword       Boolean?
  backupCodesSafe      Boolean?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// One-time OAuth state — survives cookie edge cases on re-connect
model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  visitorId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorType  String   @default("system") // system | visitor | admin
  actorId    String?
  /// Safe metadata only — never store tokens/secrets
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

/// Sellable digital products / packages
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortDesc   String   @default("")
  description String   @default("")
  price       Int
  currency    String   @default("TRY")
  category    String   @default("dijital")
  badge       String   @default("")
  icon        String   @default("social")
  accent      String   @default("#2ec4b6")
  accent2     String   @default("#7c5cff")
  features    String   @default("[]") // JSON string array
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       OrderLead[]

  @@index([active, featured])
  @@index([category])
}

/// Simple order / interest leads (no card payment yet)
model OrderLead {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  phone     String   @default("")
  email     String   @default("")
  note      String   @default("")
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Analysis job / result — never invent user lists; empty when API lacks data
model AnalysisRun {
  id               String   @id @default(cuid())
  visitorSessionId String?
  connectionId     String?
  /// profile_visit | blocking | unfollowers | non_followers | fake_risk | general
  type             String
  /// pending | running | completed | insufficient_data | unavailable
  status           String   @default("pending")
  /// estimated | signal | comparative | unavailable
  mode             String   @default("unavailable")
  summary          String   @default("")
  /// Safe JSON result — no fake usernames
  resultJson       String   @default("{}")
  errorMessage     String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([type, createdAt])
  @@index([visitorSessionId])
  @@index([status])
}

/// Snapshot of following/followers when Graph API actually returns them
model RelationshipSnapshot {
  id               String   @id @default(cuid())
  connectionId     String
  /// followers | following
  listType         String
  /// JSON array of { id, username } from API — empty if unavailable
  entriesJson      String   @default("[]")
  entryCount       Int      @default(0)
  source           String   @default("graph_api")
  createdAt        DateTime @default(now())

  @@index([connectionId, listType, createdAt])
}

model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  level     String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

/// Site members (customer accounts)
model Member {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String     @default("")
  phone        String     @default("")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       SmmOrder[]

  @@index([createdAt])
}

/// Cached SMM panel services (smmapi.com) with markup sell rate
model SmmService {
  id                String   @id @default(cuid())
  /// Provider service id from SMM API
  providerServiceId Int      @unique
  name              String
  type              String   @default("Default")
  category          String   @default("")
  /// Provider rate per 1000 (TRY)
  rate              Float
  /// Customer sell rate = rate * (1 + markup) — default +50%
  sellRate          Float
  min               Int      @default(1)
  max               Int      @default(1000000)
  dripfeed          Boolean  @default(false)
  refill            Boolean  @default(false)
  cancel            Boolean  @default(false)
  active            Boolean  @default(true)
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            SmmOrder[]

  @@index([category, active])
  @@index([active, sellRate])
  @@index([name])
}

/// Member orders placed against SMM services
model SmmOrder {
  id              String     @id @default(cuid())
  memberId        String
  member          Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         SmmService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  providerServiceId Int
  serviceName     String     @default("")
  link            String
  quantity        Int
  /// Charged to customer (sell rate)
  charge          Float      @default(0)
  /// Provider cost estimate
  cost            Float      @default(0)
  status          String     @default("pending") // pending | processing | completed | partial | canceled | error
  providerOrderId String?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([memberId, createdAt])
  @@index([status, createdAt])
}
