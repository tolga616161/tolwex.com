generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorType String   @default("system")
  actorId   String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model Member {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String    @unique
  passwordHash   String
  name           String    @default("")
  phone          String    @default("")
  balance        Float     @default(0)
  spent          Float     @default(0)
  apiKey         String    @unique @default(cuid())
  active         Boolean   @default(true)
  /** Registration IP — one account per IP for welcome campaign */
  registerIp     String    @default("")
  /** Existing members default verified; new signups set false until OTP */
  emailVerified  Boolean   @default(true)
  phoneVerified  Boolean   @default(true)
  emailOtp       String    @default("")
  phoneOtp       String    @default("")
  otpExpiresAt   DateTime?
  welcomeBonusAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders          SmmOrder[]
  transactions    WalletTransaction[]
  balanceRequests BalanceRequest[]
  tickets         SupportTicket[]

  @@index([createdAt])
  @@index([registerIp])
  @@index([phone])
}

model SmmService {
  id                String   @id @default(cuid())
  providerServiceId Int      @unique
  name              String
  description       String   @default("")
  type              String   @default("Default")
  category          String   @default("")
  rate              Float
  sellRate          Float
  min               Int      @default(1)
  max               Int      @default(1000000)
  /** Position in smmapi services[] response — keep panel order identical */
  sortOrder         Int      @default(0)
  dripfeed          Boolean  @default(false)
  refill            Boolean  @default(false)
  cancel            Boolean  @default(false)
  active            Boolean  @default(true)
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            SmmOrder[]

  @@index([category, active])
  @@index([active, sellRate])
  @@index([active, sortOrder])
  @@index([category, sortOrder])
}

model SmmOrder {
  id                String      @id @default(cuid())
  memberId          String
  member            Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           SmmService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  providerServiceId Int
  serviceName       String      @default("")
  serviceType       String      @default("Default")
  link              String
  quantity          Int
  charge            Float       @default(0)
  cost              Float       @default(0)
  status            String      @default("pending")
  providerOrderId   String?
  startCounter      Int?
  remains           Int?
  comments          String      @default("")
  dripfeedRuns      Int?
  dripfeedInterval  Int?
  errorMessage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([providerOrderId])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type         String
  amount       Float
  balanceAfter Float    @default(0)
  note         String   @default("")
  refId        String   @default("")
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt])
}

model BalanceRequest {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("whatsapp")
  note      String   @default("")
  status    String   @default("pending")
  adminNote String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Float     @default(0)
  percent   Float     @default(0)
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subject   String
  message   String
  /** general | closed | fake | stolen */
  kind      String   @default("general")
  /** Optional screenshot data URL from hesap yardım forms */
  imageData String   @default("")
  status    String   @default("open")
  reply     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NewsItem {
  id        String   @id @default(cuid())
  type      String   @default("announcement")
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model PanelSetting {
  id        String   @id @default("main")
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}

/** SEO blog posts (persisted + gist-backed on Vercel). */
model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String    @default("")
  content        String    @default("")
  coverImage     String    @default("")
  tags           String    @default("[]")
  seoTitle       String    @default("")
  seoDescription String    @default("")
  author         String    @default("TOLWEX")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([createdAt])
}

/** Lightweight visitor analytics (IP, path, enter/exit). */
model SiteVisit {
  id        String    @id @default(cuid())
  sessionId String
  ip        String    @default("")
  path      String    @default("/")
  referrer  String    @default("")
  userAgent String    @default("")
  country   String    @default("")
  enteredAt DateTime  @default(now())
  leftAt    DateTime?
  hitCount  Int       @default(1)

  @@index([enteredAt])
  @@index([ip, enteredAt])
  @@index([sessionId])
  @@index([path, enteredAt])
}
