generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorType String   @default("system")
  actorId   String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model Member {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String   @default("")
  phone        String   @default("")
  balance      Float    @default(0)
  spent        Float    @default(0)
  apiKey       String   @unique @default(cuid())
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders           SmmOrder[]
  transactions     WalletTransaction[]
  balanceRequests  BalanceRequest[]
  tickets          SupportTicket[]

  @@index([createdAt])
}

model SmmService {
  id                String   @id @default(cuid())
  providerServiceId Int      @unique
  name              String
  type              String   @default("Default")
  category          String   @default("")
  rate              Float
  sellRate          Float
  min               Int      @default(1)
  max               Int      @default(1000000)
  dripfeed          Boolean  @default(false)
  refill            Boolean  @default(false)
  cancel            Boolean  @default(false)
  active            Boolean  @default(true)
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            SmmOrder[]

  @@index([category, active])
  @@index([active, sellRate])
}

model SmmOrder {
  id                String      @id @default(cuid())
  memberId          String
  member            Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           SmmService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  providerServiceId Int
  serviceName       String      @default("")
  serviceType       String      @default("Default")
  link              String
  quantity          Int
  charge            Float       @default(0)
  cost              Float       @default(0)
  status            String      @default("pending")
  providerOrderId   String?
  startCounter      Int?
  remains           Int?
  comments          String      @default("")
  dripfeedRuns      Int?
  dripfeedInterval  Int?
  errorMessage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([providerOrderId])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type         String
  amount       Float
  balanceAfter Float    @default(0)
  note         String   @default("")
  refId        String   @default("")
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt])
}

model BalanceRequest {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("whatsapp")
  note      String   @default("")
  status    String   @default("pending")
  adminNote String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Float     @default(0)
  percent   Float     @default(0)
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subject   String
  message   String
  status    String   @default("open")
  reply     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NewsItem {
  id        String   @id @default(cuid())
  type      String   @default("announcement")
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model PanelSetting {
  id        String   @id @default("main")
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}
