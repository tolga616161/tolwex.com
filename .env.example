# =============================================================================
# TOLWEX — Environment variables
# Copy to .env and fill real values. NEVER commit secrets.
# =============================================================================

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://tolwex.com

# SQLite (or other Prisma URL)
DATABASE_URL="file:./dev.db"

# Iron-session cookie encryption — min 32 characters
# Generate: openssl rand -base64 48
SESSION_SECRET=

# AES encryption for Meta tokens / app secret at rest — 64 hex chars (32 bytes)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Meta / Instagram Official OAuth
# Get values from: https://developers.facebook.com/apps/
# Secrets stay server-side only — never expose META_APP_SECRET to the browser.
# -----------------------------------------------------------------------------

# Meta App → Settings → Basic → App ID
META_APP_ID=

# Meta App → Settings → Basic → App Secret (Show)
META_APP_SECRET=

# Must match exactly a Valid OAuth Redirect URI in Meta Login settings
# Path is fixed by this app: /api/meta/oauth/callback
META_REDIRECT_URI=https://tolwex.com/api/meta/oauth/callback

# Graph API version (e.g. v21.0)
META_API_VERSION=v21.0

# Meta App → Webhooks → Verify Token (you invent a strong random string)
# Generate: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=

# Admin panel password (/admin61) — production required
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# SMM Provider (smmapi.com) — server only
# -----------------------------------------------------------------------------
SMM_API_URL=https://smmapi.com/api/v2
SMM_API_KEY=
# Customer sell price = provider rate * (1 + markup/100)
SMM_MARKUP_PERCENT=50
