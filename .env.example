# Application
NEXT_PUBLIC_APP_URL=https://tolwex.com
DATABASE_URL="file:./dev.db"

# Session cookie encryption (min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Token / secret encryption at rest (32-byte key as hex = 64 hex chars)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Meta / Instagram (official OAuth) — never commit real values
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://tolwex.com/api/meta/oauth/callback
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# Optional: simple admin gate for /admin (set in production)
ADMIN_PASSWORD=
