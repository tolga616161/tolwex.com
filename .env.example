# =============================================================================
# TOLWEX SMM Panel — Environment variables
# Copy to .env and fill real values. NEVER commit secrets.
# =============================================================================

NEXT_PUBLIC_APP_URL=https://tolwex.com
NEXT_PUBLIC_WHATSAPP_NUMBER=905338236175

DATABASE_URL="file:./dev.db"

# Iron-session cookie encryption — min 32 characters
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Admin panel password (/admin61)
ADMIN_PASSWORD=

# smmapi.com — server only
SMM_API_URL=https://smmapi.com/api/v2
SMM_API_KEY=
# Customer sell price = provider rate * (1 + markup/100) — default +125% kâr
SMM_MARKUP_PERCENT=125

# Cron: GET /api/cron/sync-orders?key=...
CRON_SECRET=

# Durable member/payment sync (private GitHub gist)
DB_GIST_ID=
DB_SYNC_TOKEN=

# Shopier (bakiye yükleme) — Shopier panel → API bilgileri
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
